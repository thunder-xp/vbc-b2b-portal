# Service. RELAY_HOST is intentionally unsupported: the process always binds 127.0.0.1.
RELAY_PORT=8091
RELAY_VERSION=1.0.0
RELAY_DATABASE_PATH=/var/lib/nsd-sms-relay/relay.sqlite
RELAY_KEY_ID=
RELAY_AUTH_SECRET=
RELAY_REPLAY_WINDOW_SECONDS=300
RELAY_IDEMPOTENCY_TTL_SECONDS=604800
RELAY_RATE_LIMIT_PER_MINUTE=30

# Provider. Secrets remain only on the relay host.
MOLDCELL_BASE_URL=https://wsg.moldcell.md
MOLDCELL_PROVIDER_ID=
MOLDCELL_CUSTOMER_ID=
MOLDCELL_GUID=
MOLDCELL_SENDER=NSD
MOLDCELL_TEMPLATE=NSD_NOTIFICATION
MOLDCELL_TIMEOUT_MS=10000
